select(((.kind == "Deployment" or .kind == "ServiceAccount" or .kind == "Service") and (.metadata.name as $n | ["helm-controller","image-reflector-controller","image-automation-controller","source-watcher"] | any_c(. == $n))) | not)
| select((.kind == "CustomResourceDefinition" and (.metadata.name as $n | ["helmreleases.helm.toolkit.fluxcd.io","imageupdateautomations.image.toolkit.fluxcd.io","imagerepositories.image.toolkit.fluxcd.io","imagepolicies.image.toolkit.fluxcd.io","artifactgenerators.source.extensions.fluxcd.io"] | any_c(. == $n))) | not)
| (select(.kind == "ClusterRoleBinding") | .subjects) |= map(select(.name as $n | ["helm-controller","image-reflector-controller","image-automation-controller","source-watcher"] | any_c(. == $n) | not))
