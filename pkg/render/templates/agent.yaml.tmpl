# Rendered by tapctl from {{ .Agent.Metadata.Name }} {{ .Agent.Metadata.Version }}; do not edit.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ .Namespace }}
  labels:
    tap.hiddenfield.dev/agent: {{ .Agent.Metadata.Name }}
    tap.hiddenfield.dev/owner: {{ .Owner }}
    # Kyverno's webhooks see only labelled namespaces (tapctl admission policy).
    tap.hiddenfield.dev/admission: verify
    # baseline, not restricted: the runner needs SETUID/SETGID/CHOWN/KILL to
    # run each tool under its own uid. Everything else meets restricted.
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: agent
  namespace: {{ .Namespace }}
automountServiceAccountToken: false
---
# External Secrets Operator logs in to OpenBao as this account (audience
# {{ .Platform.Secrets.Audience }}). OpenBao lets it read {{ .Platform.Secrets.KVMount }}/{{ .Platform.Secrets.Prefix }}/{{ .Namespace }}/* and the
# platform secrets under {{ .Platform.Secrets.SharedPrefix }}/, and write {{ .Platform.Secrets.EgressPrefix }}/{{ .Namespace }}.
# No pod runs as it.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: tap-secrets
  namespace: {{ .Namespace }}
automountServiceAccountToken: false
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: openbao
  namespace: {{ .Namespace }}
spec:
  provider:
    vault:
      server: {{ .Platform.Secrets.Server }}
      path: {{ .Platform.Secrets.KVMount }}
      version: v2
      auth:
        kubernetes:
          mountPath: {{ .Platform.Secrets.AuthMount }}
          role: {{ .Platform.Secrets.Role }}
          serviceAccountRef:
            name: tap-secrets
            audiences: [{{ .Platform.Secrets.Audience }}]
{{- if .HasSecrets }}
---
# The runner's tool-secrets Secret, one key per declared secret.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: tool-secrets
  namespace: {{ .Namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef: { kind: SecretStore, name: openbao }
  target:
    name: tool-secrets
    creationPolicy: Owner
  data:
{{- range .SecretRefs }}
    - secretKey: {{ .Name }}
      remoteRef: { key: {{ .Key }}, property: value }
{{- end }}
{{- end }}
---
# Harness only: the model gateway key, shared by every agent.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: model-credentials
  namespace: {{ .Namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef: { kind: SecretStore, name: openbao }
  target:
    name: model-credentials
    creationPolicy: Owner
  data:
    - secretKey: api-key
      remoteRef: { key: {{ .Platform.Secrets.SharedPrefix }}/model-credentials, property: api-key }
{{- if .Hooks }}
---
# Harness only: what tap-hooks sends to the trigger port.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: trigger-token
  namespace: {{ .Namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef: { kind: SecretStore, name: openbao }
  target:
    name: trigger-token
    creationPolicy: Owner
  data:
    - secretKey: token
      remoteRef: { key: {{ .Platform.Secrets.SharedPrefix }}/trigger-token, property: token }
{{- end }}
{{- if .Sessions }}
---
# casa-collector only: the write key for the session trace bucket.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: sessions-credentials
  namespace: {{ .Namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef: { kind: SecretStore, name: openbao }
  target:
    name: sessions-credentials
    creationPolicy: Owner
  data:
    - secretKey: access-key-id
      remoteRef: { key: {{ .Platform.Secrets.SharedPrefix }}/sessions-credentials, property: access-key-id }
    - secretKey: secret-access-key
      remoteRef: { key: {{ .Platform.Secrets.SharedPrefix }}/sessions-credentials, property: secret-access-key }
{{- end }}
---
# Harness -> runner bearer token on loopback. Generated once; never rotated
# by a sync (both containers read it at startup).
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: runner-token
  namespace: {{ .Namespace }}
spec:
  length: 64
  digits: 16
  symbols: 0
  noUpper: false
  allowRepeat: true
  secretKeys: [token]
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: runner-token
  namespace: {{ .Namespace }}
spec:
  refreshPolicy: CreatedOnce
  target:
    name: runner-token
    creationPolicy: Owner
  dataFrom:
    - sourceRef:
        generatorRef: { apiVersion: generators.external-secrets.io/v1alpha1, kind: Password, name: runner-token }
{{- if .EgressKey }}
---
# The agent's egress key: the runner and casa-collector sign per-call proxy
# credentials with it. Generated once here, pushed to OpenBao, and read from
# there by the egress proxy.
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: egress-key
  namespace: {{ .Namespace }}
spec:
  length: 64
  digits: 16
  symbols: 0
  noUpper: false
  allowRepeat: true
  secretKeys: [key]
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: egress-key
  namespace: {{ .Namespace }}
spec:
  refreshPolicy: CreatedOnce
  target:
    name: egress-key
    creationPolicy: Owner
  dataFrom:
    - sourceRef:
        generatorRef: { apiVersion: generators.external-secrets.io/v1alpha1, kind: Password, name: egress-key }
---
apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: egress-key
  namespace: {{ .Namespace }}
spec:
  refreshInterval: 10m
  updatePolicy: Replace
  # Not Delete: the finalizer would need this namespace's SecretStore while
  # the namespace is being deleted. A leftover key grants nothing, because
  # the proxy also requires the agent's policy ConfigMap, which goes with it.
  deletionPolicy: None
  secretStoreRefs:
    - { kind: SecretStore, name: openbao }
  selector:
    secret: { name: egress-key }
  data:
    - match:
        secretKey: key
        remoteRef: { remoteKey: {{ .Platform.Secrets.EgressPrefix }}/{{ .Namespace }}, property: key }
{{- end }}
---
# The agent's egress allowlist. The proxy watches ConfigMaps with this label
# in its own namespace; the label value is the agent.
apiVersion: v1
kind: ConfigMap
metadata:
  name: egress-policy-{{ .Agent.Metadata.Name }}
  namespace: {{ .ProxyNamespace }}
  labels:
    tap.hiddenfield.dev/egress-policy: {{ .Agent.Metadata.Name }}
data:
  policy.json: {{ quote .EgressPolicy }}
---
# Default deny; everything below opens one path.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
  namespace: {{ .Namespace }}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ingress-from-gateway
  namespace: {{ .Namespace }}
spec:
  podSelector:
    matchLabels: { tap.hiddenfield.dev/agent: {{ .Agent.Metadata.Name }} }
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: {{ .Platform.Gateway.PodNamespace }} }
          podSelector:
            matchLabels:
              gateway.envoyproxy.io/owning-gateway-name: {{ .Platform.Gateway.Name }}
              gateway.envoyproxy.io/owning-gateway-namespace: {{ .Platform.Gateway.Namespace }}
      ports:
        - { protocol: TCP, port: 8080 }
{{- if .Hooks }}
---
# Hook triggers: only tap-hooks, on a port the gateway never routes to.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ingress-from-hooks
  namespace: {{ .Namespace }}
spec:
  podSelector:
    matchLabels: { tap.hiddenfield.dev/agent: {{ .Agent.Metadata.Name }} }
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: {{ .Platform.Gateway.Namespace }} }
          podSelector:
            matchLabels: { app: tap-hooks }
      ports:
        - { protocol: TCP, port: 8081 }
{{- end }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: egress-dns-and-model
  namespace: {{ .Namespace }}
spec:
  podSelector:
    matchLabels: { tap.hiddenfield.dev/agent: {{ .Agent.Metadata.Name }} }
  policyTypes: [Egress]
  egress:
    - to:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: kube-system }
          podSelector:
            matchLabels: { k8s-app: kube-dns }
      ports:
        - { protocol: UDP, port: 53 }
        - { protocol: TCP, port: 53 }
    - to:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: {{ .Platform.Model.NetworkPolicy.Namespace }} }
          podSelector:
            matchLabels:
{{- range $k, $v := .Platform.Model.NetworkPolicy.PodLabels }}
              {{ $k }}: {{ $v }}
{{- end }}
      ports:
        - { protocol: TCP, port: {{ .Platform.Model.NetworkPolicy.Port }} }
{{- if or .HasEgress .Sessions }}
    # Tool traffic (and casa-collector's session uploads) leave only through the egress proxy.
    - to:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: {{ .Platform.Gateway.Namespace }} }
          podSelector:
            matchLabels: { app: egress-proxy }
      ports:
        - { protocol: TCP, port: 3128 }
{{- end }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agent
  namespace: {{ .Namespace }}
  # Read by `tapctl agent ls` and the console (quoted so any text is valid YAML).
  annotations:
    tap.hiddenfield.dev/description: {{ quote .Agent.Metadata.Description }}
{{- with .Agent.Metadata.Title }}
    tap.hiddenfield.dev/title: {{ quote . }}
{{- end }}
    tap.hiddenfield.dev/owner: {{ quote .Agent.Metadata.Owner }}
    tap.hiddenfield.dev/model: {{ quote .Agent.Harness.Model.Name }}
    tap.hiddenfield.dev/tools: {{ quote .ToolNames }}
    tap.hiddenfield.dev/mcp: {{ quote .MCPNames }}
    tap.hiddenfield.dev/egress: {{ quote .EgressHosts }}
    tap.hiddenfield.dev/url: {{ quote .URL }}
  labels: &labels
    app.kubernetes.io/name: {{ .Agent.Metadata.Name }}
    app.kubernetes.io/version: {{ .Agent.Metadata.Version }}
    tap.hiddenfield.dev/agent: {{ .Agent.Metadata.Name }}
spec:
  replicas: 1
  revisionHistoryLimit: 3
  selector:
    matchLabels: { tap.hiddenfield.dev/agent: {{ .Agent.Metadata.Name }} }
  template:
    metadata:
      labels: *labels
      annotations:
        tap.hiddenfield.dev/bundle: {{ .BundleRef }}
        tap.hiddenfield.dev/spec-hash: {{ .SpecHash }}
    spec:
      runtimeClassName: {{ .Platform.RuntimeClass }}
      serviceAccountName: agent
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: { type: RuntimeDefault }
      initContainers:
        # Native sidecar: the only container that runs tool code or holds tool secrets.
        - name: runner
          image: {{ .Agent.Runner.Image }}
          restartPolicy: Always
          args:
            - --bundle=/bundle
            - --listen=127.0.0.1:7070
            - --token-file=/run/tap/token/token
            - --secrets-dir=/run/tap/secrets
            - --workspace=/workspace
            - --tool-uid-base={{ .Platform.ToolUIDBase }}
{{- if .HasEgress }}
            - --egress-proxy={{ .Platform.EgressProxy.Address }}
            - --egress-key-file=/run/tap/egress/key
{{- end }}
          env:
            - { name: TAP_AGENT, value: {{ .Agent.Metadata.Name }} }
          startupProbe:
            exec: { command: [tap-runner, health, --listen=127.0.0.1:7070] }
            periodSeconds: 1
            failureThreshold: 30
          livenessProbe:
            exec: { command: [tap-runner, health, --listen=127.0.0.1:7070] }
            periodSeconds: 20
          resources:
            requests: { cpu: {{ .RunnerCPU }}, memory: {{ .RunnerMemory }} }
            limits: { memory: {{ .RunnerMemory }} }
          # Root inside the gVisor sandbox with four capabilities, so tools can
          # run as other uids and never read the runner's secret files (0440,
          # group fsGroup; tools have neither).
          securityContext:
            runAsUser: 0
            runAsGroup: 0
            runAsNonRoot: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL], add: [SETUID, SETGID, CHOWN, KILL] }
          volumeMounts:
            - { name: bundle, subPath: runner, mountPath: /bundle, readOnly: true }
            - { name: workspace, mountPath: /workspace }
            - { name: runner-tmp, mountPath: /tmp }
            - { name: token, mountPath: /run/tap/token, readOnly: true }
{{- if .HasSecrets }}
            - { name: tool-secrets, mountPath: /run/tap/secrets, readOnly: true }
{{- end }}
{{- if .HasEgress }}
            - { name: egress-key, mountPath: /run/tap/egress, readOnly: true }
{{- end }}
{{- if .Sessions }}
        # Native sidecar: uploads the traces the harness writes to /traces. The
        # only container holding the bucket key. It stops after the harness,
        # so its final scan picks up the last turn.
        - name: casa-collector
          image: {{ .Platform.Sessions.CollectorImage }}
          restartPolicy: Always
          args:
            - --dir=/traces
            # The agent's own prefix: the harness cannot write another agent's keys.
            - --prefix={{ .Agent.Metadata.Name }}
            - --endpoint={{ .Platform.Sessions.Endpoint }}
            - --bucket={{ .Platform.Sessions.Bucket }}
            - --region={{ or .Platform.Sessions.Region "auto" }}
            - --credentials-dir=/run/tap/sessions
            - --egress-proxy={{ .Platform.EgressProxy.Address }}
            - --egress-key-file=/run/tap/egress/key
            - --egress-agent={{ .Agent.Metadata.Name }}
            - --egress-scope={{ .SessionsScope }}
            - --max-size=16777216
            # Within the pod's 30s grace period, after the harness's 20s.
            - --drain-timeout=5s
          resources:
            requests: { cpu: 10m, memory: 32Mi }
            limits: { memory: 64Mi }
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL] }
          volumeMounts:
            - { name: traces, mountPath: /traces, readOnly: true }
            - { name: egress-key, mountPath: /run/tap/egress, readOnly: true }
            - { name: sessions-credentials, mountPath: /run/tap/sessions, readOnly: true }
{{- end }}
      containers:
        - name: harness
          image: {{ .HarnessImage }}
          args:
            - --bundle=/bundle
            - --listen=:8080
            - --runner=http://127.0.0.1:7070
            - --token-file=/run/tap/token/token
            - --model-base-url={{ .Platform.Model.BaseURL }}
            - --model-key-header={{ .Platform.Model.APIKeyHeader }}
            - --model-key-file=/run/tap/model/api-key
            - --workspace=/workspace
{{- if .Hooks }}
            - --trigger-listen=:8081
            - --trigger-token-file=/run/tap/trigger/token
{{- end }}
{{- if .Sessions }}
            - --traces-dir=/traces
{{- end }}
          env:
            - { name: TAP_AGENT, value: {{ .Agent.Metadata.Name }} }
          ports:
            - { name: http, containerPort: 8080 }
{{- if .Hooks }}
            - { name: trigger, containerPort: 8081 }
{{- end }}
          readinessProbe:
            httpGet: { path: /healthz, port: http }
          livenessProbe:
            httpGet: { path: /healthz, port: http }
            periodSeconds: 20
          resources:
            requests: { cpu: {{ .Platform.Harness.Resources.CPU }}, memory: {{ .Platform.Harness.Resources.Memory }} }
            limits: { memory: {{ .Platform.Harness.Resources.Memory }} }
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL] }
          volumeMounts:
            - { name: bundle, subPath: harness, mountPath: /bundle, readOnly: true }
            - { name: workspace, mountPath: /workspace }
            - { name: harness-tmp, mountPath: /tmp }
            - { name: token, mountPath: /run/tap/token, readOnly: true }
            - { name: model-credentials, mountPath: /run/tap/model, readOnly: true }
{{- if .Hooks }}
            - { name: trigger-token, mountPath: /run/tap/trigger, readOnly: true }
{{- end }}
{{- if .Sessions }}
            - { name: traces, mountPath: /traces }
{{- end }}
      volumes:
        - name: bundle
          image:
            reference: {{ .BundleRef }}
            pullPolicy: IfNotPresent
        - name: workspace
          emptyDir: { sizeLimit: {{ .WorkspaceSize }} }
        - name: runner-tmp
          emptyDir: { medium: Memory, sizeLimit: 64Mi }
        - name: harness-tmp
          emptyDir: { medium: Memory, sizeLimit: 64Mi }
        # Shared secret for harness -> runner calls on loopback (generated above).
        - name: token
          secret: { secretName: runner-token, defaultMode: 0440 }
        # Harness only: the model gateway key. Never mounted into the runner.
        - name: model-credentials
          secret: { secretName: model-credentials, defaultMode: 0440 }
{{- if .HasSecrets }}
        - name: tool-secrets
          secret: { secretName: tool-secrets, defaultMode: 0440 }
{{- end }}
{{- if .Hooks }}
        # Harness only: what tap-hooks sends to the trigger port. Tools share
        # the pod's loopback, so the NetworkPolicy alone does not keep them off it.
        - name: trigger-token
          secret: { secretName: trigger-token, defaultMode: 0440 }
{{- end }}
{{- if .EgressKey }}
        - name: egress-key
          secret: { secretName: egress-key, defaultMode: 0440 }
{{- end }}
{{- if .Sessions }}
        # Harness and collector only (not the workspace, which tools can write):
        # session traces waiting to be uploaded.
        - name: traces
          emptyDir: { sizeLimit: {{ .WorkspaceSize }} }
        # Collector only: the write key for the session trace bucket.
        - name: sessions-credentials
          secret: { secretName: sessions-credentials, defaultMode: 0440 }
{{- end }}
---
apiVersion: v1
kind: Service
metadata:
  name: agent
  namespace: {{ .Namespace }}
spec:
  selector: { tap.hiddenfield.dev/agent: {{ .Agent.Metadata.Name }} }
  ports:
    - { name: http, port: 80, targetPort: http }
{{- if .Hooks }}
    # Not referenced by the HTTPRoute; tap-hooks calls it directly.
    - { name: trigger, port: 8081, targetPort: trigger }
{{- end }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: agent
  namespace: {{ .Namespace }}
spec:
  parentRefs:
    - name: {{ .Platform.Gateway.Name }}
      namespace: {{ .Platform.Gateway.Namespace }}
      sectionName: {{ .Platform.Gateway.Listener }}
  hostnames: [{{ .Host }}]
  rules:
    - backendRefs:
        - { name: agent, port: 80 }
      timeouts:
        # Chat responses stream for as long as the agent loop runs.
        request: 0s
